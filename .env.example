# Build / dev: kopyala -> .env veya production build ortamında ayarla
VITE_API_BASE_URL=http://localhost:5000/api
# Google reCAPTCHA v2 "Ben robot değilim" — Admin Console'da bu site için anahtar oluştur:
# https://www.google.com/recaptcha/admin — Alan türü: reCAPTCHA v2 > "I'm not a robot" Checkbox
# Domain listesine production host'unu ekle (örn. uzaktan.gazi.edu.tr ve localhost geliştirme için).
VITE_RECAPTCHA_SITE_KEY=
